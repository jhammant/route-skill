#!/bin/bash
# claude-work: Claude Code on the second (work) subscription, for this process
# only. The account's `claude setup-token` token lives in the macOS Keychain and
# reaches claude through CLAUDE_CODE_OAUTH_TOKEN, so your main login and every
# other session are untouched. Transcripts land in the usual ~/.claude, which is
# what lets a worker fork a session (`--resume <id> --fork-session`).
#
#   claude-work login [--browser APP | --chrome-profile DIR]
#                         mint a token and store it (run in a normal terminal tab). By default no
#                         browser opens: the sign-in URL is printed for you to open wherever the
#                         work account is signed in, so your main browser profile is never touched.
#   claude-work status    is a token stored, and how much of the work quota is used?
#   claude-work logout    delete the stored token
#   claude-work <args>    anything else runs `claude <args>` on the work account
set -euo pipefail

SERVICE="${CLAUDE_WORK_KEYCHAIN:-claude-work-oauth}"
QUOTAMAX="${QUOTAMAX:-quotamax}"

stored_token() { security find-generic-password -s "$SERVICE" -w 2>/dev/null; }
main_login_fingerprint() {
  security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null | shasum -a 256 | cut -c1-16
}

# A setup-token, from text that may hold ANSI codes and a wrapped, indented line.
# Prints nothing unless the result looks like a whole token.
normalize_token() {
  python3 -I -c '
import re, sys
text = re.sub(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07", "", sys.stdin.read()).replace("\r", "")
m = re.search(r"sk-ant-oat01-[A-Za-z0-9_\-\s]+", text)
if m:
    token = re.sub(r"\s+", "", re.split(r"\n[ \t]*\n", m.group(0))[0])
    if re.fullmatch(r"sk-ant-oat01-[A-Za-z0-9_-]{60,}", token):
        print(token)
'
}

extract_token() { [ -f "$1" ] && normalize_token < "$1"; }

# Hidden multi-line read: lines until an empty one, then normalised.
read_pasted_token() {
  local line all=""
  while IFS= read -rs line && [ -n "$line" ]; do all="$all$line"$'\n'; done
  printf '%s' "$all" | normalize_token
}

# Into the Keychain through `security -i` on stdin, so the token is never on argv.
store_token() {
  printf 'add-generic-password -U -s "%s" -a "%s" -l "Claude Code work account (setup-token)" -w "%s"\n' \
    "$SERVICE" "$USER" "$1" | security -i >/dev/null
  case "$(stored_token)" in
    sk-ant-oat01-*) ;;
    *) echo "claude-work: storing the token failed." >&2; exit 1 ;;
  esac
}

# write_opener PATH APP PROFILE: a $BROWSER script that opens its URL in a Chrome
# profile, in a named app, or (both empty) only prints it.
write_opener() {
  {
    echo '#!/bin/bash'
    if [ -n "$3" ]; then
      printf 'open -na "Google Chrome" --args --profile-directory=%q "$1"\n' "$3"
    elif [ -n "$2" ]; then
      printf 'open -a %q "$1"\n' "$2"
    else
      echo 'printf "\n  Sign-in URL (open it where the work account is signed in):\n  %s\n\n" "$1"'
    fi
  } > "$1"
  chmod +x "$1"
}

login() {
  if [ ! -t 0 ]; then
    echo "claude-work login needs a real terminal (it opens a browser and asks you to paste)." >&2
    exit 2
  fi
  local app="" profile=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --browser) app="${2:?--browser needs an app name, e.g. Firefox}"; shift 2 ;;
      --chrome-profile) profile="${2:?--chrome-profile needs a profile directory, e.g. Profile 2}"; shift 2 ;;
      *) echo "claude-work login: unknown option $1" >&2; exit 2 ;;
    esac
  done
  cat <<'EOF'
claude-work login
  1. Open the sign-in URL printed below in the browser where claude.ai is signed in as the
     WORK account (or a private window: sign in as work there, approve, close it).
     Check the page names the work account before you approve.
  2. When it finishes, the token is picked up and stored in the Keychain for you.
     (If that fails you'll be asked to paste it; wrapped lines and spaces are fine.)

EOF
  # A throwaway config dir gives this login its own Keychain item name
  # ("Claude Code-credentials-<hash of the dir>"), so your main login cannot change.
  local before tmp hash
  before="$(main_login_fingerprint)"
  tmp="$(mktemp -d)"
  hash="$(printf %s "$tmp" | shasum -a 256 | cut -c1-8)"
  # Claude Code opens URLs with $BROWSER. Point it at a tiny opener so the sign-in
  # page goes to the work browser/profile, or nowhere (just printed) by default.
  write_opener "$tmp/open-url" "$app" "$profile"
  # `script` records the session (in this owner-only temp dir) so the token can be
  # read back without copy-paste: the terminal UI wraps it and indents the wrap.
  script -q "$tmp/session.log" env BROWSER="$tmp/open-url" CLAUDE_CONFIG_DIR="$tmp" claude setup-token || true
  local token
  token="$(extract_token "$tmp/session.log")"
  security delete-generic-password -s "Claude Code-credentials-$hash" >/dev/null 2>&1 || true
  rm -rf "$tmp"

  if [ -z "$token" ]; then
    echo
    echo "Couldn't read the token from the screen. Paste it below, then press Enter on an empty line"
    echo "(input is hidden; line breaks and spaces inside it are fine):"
    token="$(read_pasted_token)"
  fi
  if [ -z "$token" ]; then
    echo "That didn't look like a setup-token token (sk-ant-oat01-...). Nothing stored; run claude-work login again." >&2
    exit 1
  fi
  store_token "$token"
  token=""
  echo "Stored in the Keychain as \"$SERVICE\"."
  if [ "$before" != "$(main_login_fingerprint)" ]; then
    echo "WARNING: your main Claude Code login changed during this. Run /login in a normal claude session to restore it." >&2
  fi
  echo
  status
}

status() {
  if ! stored_token >/dev/null; then
    echo "claude-work: no token stored. Run: claude-work login"
    return 1
  fi
  echo "claude-work: token stored (Keychain \"$SERVICE\"). Taking a fresh quota reading..."
  "$QUOTAMAX" probe claude-work
  echo
  echo "main account, for comparison (a different account shows different numbers and reset times):"
  "$QUOTAMAX" status 2>/dev/null | sed -n '/5h session/,/weekly (all)/p' || true
}

case "${1:-}" in
  login) shift; login "$@" ;;
  status) status ;;
  logout)
    security delete-generic-password -s "$SERVICE" >/dev/null 2>&1 && echo "claude-work: token deleted." || echo "claude-work: no token stored." ;;
  *)
    if ! TOKEN="$(stored_token)"; then
      echo "claude-work: no token stored. Run: claude-work login" >&2
      exit 1
    fi
    # Credentials that outrank an OAuth token would silently pick another account.
    unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
    export CLAUDE_CODE_OAUTH_TOKEN="$TOKEN"
    export CLAUDE_WORK_ACCOUNT=1
    exec claude "$@" ;;
esac
