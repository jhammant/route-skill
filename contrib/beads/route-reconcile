#!/usr/bin/env bash
# route-reconcile shim -> route_reconcile.py.
#
# Installed onto PATH under the bare name `route-reconcile` (see install.sh)
# so a session-start hook can call it with no arguments, from any directory,
# without knowing where route-skill is checked out.
#
# Deliberately thin: locate the reconciler next to this script, find an
# interpreter, run it against the caller's cwd, swallow the result. All
# argument parsing, logging, and configuration belong to route_reconcile.py,
# not here.
#
# Fail open, always: a missing python3, a missing reconciler file, or the
# reconciler crashing/exiting non-zero must never fail the caller. A session
# must never fail to start because reconciliation did.
#
# No `-e` here, deliberately -- same reasoning as route-bead-hook.sh: with
# `-e`, a failing command ahead of the fail-open guards would exit non-zero
# before this script gets to swallow it, turning a fail-open path into a
# hard failure. Do not add `-e` in a later "tighten the shell flags" pass.
set -uo pipefail

# Resolve the directory this script lives in, not the directory a symlink to
# it lives in: `route-reconcile` on PATH is a symlink (installed by
# install.sh) pointing at this file inside the checkout, and
# `dirname "${BASH_SOURCE[0]}"` alone would resolve to the symlink's own
# directory (e.g. ~/.local/bin) rather than the contrib/beads/ dir where
# route_reconcile.py actually lives. `cd -P` (via `pwd`'s default physical
# resolution) after following the symlink with a readlink loop is what makes
# this robust; a plain `dirname` is not sufficient for a symlinked caller.
resolve_script_path() {
  local target="$1"
  while [ -L "$target" ]; do
    local link
    link=$(readlink "$target")
    case "$link" in
      /*) target="$link" ;;
      *) target="$(dirname "$target")/$link" ;;
    esac
  done
  printf '%s' "$target"
}

SELF="$(resolve_script_path "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
RECONCILER="$SCRIPT_DIR/route_reconcile.py"

command -v python3 >/dev/null 2>&1 || exit 0
[ -f "$RECONCILER" ] || exit 0

# The first positional arg is the repo path, everything after it is forwarded
# to the reconciler as-is (e.g. `route-reconcile --dry-run`, with no repo
# path, must reach route_reconcile.py as `--dry-run`, not as the value of
# `--repo`). A first arg that looks like a flag (empty, or starting with
# `-`) means no repo path was given at all, so default it to $PWD and
# forward every arg unchanged; otherwise the first arg is the repo path and
# the rest are forwarded from $2 on.
case "${1:-}" in
  "" | -*) python3 "$RECONCILER" --repo "$PWD" "$@" || true ;;
  *) python3 "$RECONCILER" --repo "$1" "${@:2}" || true ;;
esac
exit 0
